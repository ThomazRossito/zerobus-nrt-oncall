# Copy to .env and fill it in. .env is in .gitignore: never commit it.
# The Python scripts never read DATABRICKS_CLIENT_SECRET. Only Debezium Server and the OTel Collector use the
# secret, and they get it from the shell environment.

# ---- Databricks (workspace of the CLI profile) ----
DATABRICKS_CONFIG_PROFILE=DEFAULT
# project catalog; "python setup/00_environment.py create" creates it when missing
UC_CATALOG=zerobus_nrt_oncall
# serverless SQL warehouse used by the scripts, Genie and the app
WAREHOUSE_ID=
# Zerobus endpoint. Azure: <workspace-id>.zerobus.<region>.azuredatabricks.net (Phase 0 checks it)
ZEROBUS_SERVER_ENDPOINT=
# workspace URL, no trailing slash. Only Debezium uses it; the scripts never print it
DATABRICKS_WORKSPACE_URL=
# Zerobus service principal: Application ID and OAuth secret
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=

# ---- Local Postgres (Mac) ----
PG_HOST=localhost
PG_PORT=5432
PG_DBNAME=oncall
# replication user, used by Debezium (created in Phase 1)
PG_USER=
PG_PASSWORD=
# admin user, used by Phase 0 and the simulator
PG_USER_ADMIN=
PG_PASSWORD_ADMIN=
